# Copie este arquivo para .env.local e preencha com suas próprias credenciais.
# .env.local nunca deve ser commitado (já está no .gitignore).

# Google Drive integration (opcional — veja "Integração com Google Drive" no README).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Criação de conteúdo por voz com IA (opcional — veja "Criar conteúdo por voz" no README).
# Sem o prefixo NEXT_PUBLIC_: essa chave só é usada no servidor (rota /api/parse-task), nunca no navegador.
GROQ_API_KEY=